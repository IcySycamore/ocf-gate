[
  {
    "id": "control-plane-allow",
    "why": "The gate must not block the agent from reading its own state; this is the exemption that was dead code in the previous implementation.",
    "state": "asking",
    "payload": {
      "tool_name": "run_in_terminal",
      "tool_input": { "command": "python .github/ocf/ocf.py status" }
    },
    "expect": "allow",
    "expect_rule": "default"
  },
  {
    "id": "mention-is-not-invocation",
    "why": "Regression for the bypass where any command merely containing the entry name inherited the control-plane exemption.",
    "state": "asking",
    "payload": {
      "tool_name": "run_in_terminal",
      "tool_input": {
        "command": "Write-Host \".github/ocf/ocf.py\"; echo hello"
      }
    },
    "expect": "deny",
    "expect_rule": "approval-required-exec"
  },
  {
