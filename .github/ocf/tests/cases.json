  {
    "id": "posttool-continuation-prompt-warned",
    "why": "A shell left at a continuation prompt is the exact shape of a command that hung with no echo. The gate reads text and cannot predict that an unclosed quote will hang a shell, so it notices the aftermath instead.",
    "state": "executing",
    "payload": {
      "hook_event_name": "PostToolUse",
      "tool_name": "run_in_terminal",
      "tool_input": { "command": "$x = \"unclosed" },
      "tool_response": "PS D:\\PROJECT\\agent> $x = \"unclosed\n>> "
    },
    "expect_context_contains": [
      "did not report progress",
      "continuation prompt"
    ]
  },
  {
