# Build and test artifacts
__pycache__/
*.py[cod]
.pytest_cache/
# The release output: a payload tree and the artifacts built from it, both reproducible from source.
dist/

# .orchestrator/ is runtime state (state, facts, journal, exec log): produced by running this gate,
# not part of its source, so a clone does not carry one machine's history.
# .github/protected.txt is the opposite and has no line below, because a list a clone does not have is a
# list every rule still reads as if it were present.
.orchestrator/
